# /etc/meshnest/mesh.env   (installed with mode 0600 - keep it that way)
#
# Enrollment secrets for `meshnest up`. Every provider here connects OUTBOUND only;
# nothing in this file causes a firewall rule or router port-forward to be created.
# Prefer one-off / ephemeral / short-expiry keys: CLIs briefly expose them in the process list.

# Name this node will use on each mesh (default: short hostname)
MESH_HOSTNAME=

# --- Tailscale ---------------------------------------------------------------
# Auth key: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# Extra flags passed to `tailscale up`, e.g. "--accept-dns=false --advertise-tags=tag:server"
TS_EXTRA_ARGS=

# --- NetBird -----------------------------------------------------------------
# Setup key from the NetBird dashboard (Setup Keys)
NB_SETUP_KEY=
# Only for a self-hosted management server; leave empty for NetBird cloud
NB_MANAGEMENT_URL=

# --- ZeroTier ----------------------------------------------------------------
# One or more 16-char network IDs, comma separated. Authorize the node in ZeroTier Central.
ZT_NETWORK_ID=

# --- Cloudflare WARP Connector ----------------------------------------------
# Connector token from Cloudflare One > Networks > Connectors > WARP Connector
WARP_CONNECTOR_TOKEN=
# 1 = write /etc/sysctl.d/99-zzz-cloudflare-warp-connector.conf (IP forwarding, needed for connector/subnet routing)
# 0 = leave sysctl untouched (client-only use)
WARP_ENABLE_FORWARDING=1
