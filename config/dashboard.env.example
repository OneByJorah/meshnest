# /etc/j1-mesh/dashboard.env  (no secrets in here)

# Where the dashboard listens. Default is loopback only - nothing reachable from the network.
#   127.0.0.1   loopback (default)
#   tailscale   bind to this node's Tailscale IPv4 (reachable by your tailnet only)
# Wildcard binds (0.0.0.0 / ::) are refused. Any non-loopback, non-CGNAT, non-ULA address
# needs J1_MESH_ALLOW_ANY_BIND=1.
J1_MESH_BIND=127.0.0.1
J1_MESH_PORT=8787

# Seconds between probe rounds (2-300)
J1_MESH_INTERVAL=5

# Which meshes to probe (comma separated): tailscale,netbird,zerotier,warp
J1_MESH_PROVIDERS=tailscale,netbird,zerotier,warp

# Reference latency over your normal default route. Empty disables the baseline row.
J1_MESH_BASELINE=1.1.1.1

# Max peers probed per mesh per round
J1_MESH_MAX_PEERS=24

# Extra Host headers to accept (comma separated), e.g. a MagicDNS name behind `tailscale serve`.
# The node's own Tailscale DNS name is added automatically. "*" disables the check.
J1_MESH_ALLOWED_HOSTS=

# J1_MESH_ALLOW_ANY_BIND=1
# J1_MESH_ACCESS_LOG=1
